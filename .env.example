# Veja lib/env.ts para a validação - todas as vars abaixo são obrigatórias.

# Asaas (checkout + webhook)
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Supabase (service role - server-only, nunca exposto ao client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (e-mails transacionais)
RESEND_API_KEY=
MENTOR_EMAIL=

# Admin (P2 - lista de inscrições, senha única)
ADMIN_PASSWORD=

# Vercel Cron - autentica GET /api/cron/check-expirations
# (ver vercel.json: "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
